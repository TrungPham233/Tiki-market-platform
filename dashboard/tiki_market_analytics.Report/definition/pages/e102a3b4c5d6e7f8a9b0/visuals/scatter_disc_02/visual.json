{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "scatter_disc_02",
  "position": {
    "x": 40,
    "y": 630,
    "z": 2200,
    "height": 420,
    "width": 1840,
    "tabOrder": 2200
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_product_snapshot"
                    }
                  },
                  "Property": "Average Discount Rate %"
                }
              },
              "queryRef": "fact_product_snapshot.Average Discount Rate %"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_product_snapshot"
                    }
                  },
                  "Property": "Total Volume Sold"
                }
              },
              "queryRef": "fact_product_snapshot.Total Volume Sold"
            }
          ]
        },
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_product"
                    }
                  },
                  "Property": "name"
                }
              },
              "queryRef": "dim_product.name"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_product_snapshot"
                    }
                  },
                  "Property": "Total Estimated Revenue"
                }
              },
              "queryRef": "fact_product_snapshot.Total Estimated Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Tương quan Tỷ lệ giảm giá vs Sản lượng bán thực tế (Discount % vs Volume)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}