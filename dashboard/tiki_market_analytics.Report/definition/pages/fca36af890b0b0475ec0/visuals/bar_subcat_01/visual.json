{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "bar_subcat_01",
  "position": {
    "x": 40,
    "y": 240,
    "z": 2000,
    "height": 420,
    "width": 920,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_subcategory"
                    }
                  },
                  "Property": "subcategory_name"
                }
              },
              "queryRef": "dim_subcategory.subcategory_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_product_snapshot"
                    }
                  },
                  "Property": "Total Estimated Revenue"
                }
              },
              "queryRef": "fact_product_snapshot.Total Estimated Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Doanh thu theo Ngành hàng phụ (Subcategory)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}