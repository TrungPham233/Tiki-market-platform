// Star Schema Core Fact Relationships (All ACTIVE)
relationship rel_fact_product_to_dim_product
	fromColumn: fact_product_snapshot.product_id
	toColumn: dim_product.product_id

relationship rel_fact_product_to_dim_brand
	fromColumn: fact_product_snapshot.brand_id
	toColumn: dim_brand.brand_id

relationship rel_fact_product_to_dim_seller
	fromColumn: fact_product_snapshot.seller_id
	toColumn: dim_seller.seller_id

relationship rel_fact_product_to_dim_subcategory
	fromColumn: fact_product_snapshot.subcategory_id
	toColumn: dim_subcategory.subcategory_id

relationship rel_fact_product_to_dim_date
	fromColumn: fact_product_snapshot.date_key
	toColumn: dim_date.date_key

// Fact Reviews to Product and Date Dimensions (ACTIVE)
