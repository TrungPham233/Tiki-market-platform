table agg_voc_complaint_causes
	lineageTag: a098afdc-64e8-4aae-9dd3-89fb077c6810
	measure 'Total Complaint Count' = SUM(agg_voc_complaint_causes[complaint_count])
		formatString: #,##0
		lineageTag: a4a8fb12-32a1-4354-a951-8743c4a20009

	measure 'Complaint % Share' = DIVIDE(AVERAGE(agg_voc_complaint_causes[percentage_of_negative]), 100, 0)
		formatString: 0.0%
		lineageTag: a4a8fb12-32a1-4354-a951-8743c4a20010

	column complaint_category
		dataType: string
		lineageTag: 5c32a24f-a3c0-4c71-b0c8-22ef7f1f4ef9
		summarizeBy: none
		sourceColumn: complaint_category

		annotation SummarizationSetBy = Automatic

	column complaint_count
		dataType: int64
		formatString: 0
		lineageTag: 2be3063a-2661-4338-a1ac-1f07e547fb0b
		summarizeBy: sum
		sourceColumn: complaint_count

		annotation SummarizationSetBy = Automatic

	column percentage_of_negative
		dataType: double
		lineageTag: 25edab6c-1d2e-4413-a801-fe4d7f043601
		summarizeBy: sum
		sourceColumn: percentage_of_negative

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition agg_voc_complaint_causes = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("E:\baitap\Project1\tiki-market-platform\dashboard\data\tiki_market_dwh_gold.xlsx"), null, true),
				    agg_voc_complaint_causes_Sheet = Source{[Item="agg_voc_complaint_causes",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(agg_voc_complaint_causes_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"complaint_category", type text}, {"complaint_count", Int64.Type}, {"percentage_of_negative", type number}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

