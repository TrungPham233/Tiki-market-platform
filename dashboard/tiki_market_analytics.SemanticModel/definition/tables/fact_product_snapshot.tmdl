table fact_product_snapshot
	lineageTag: 5e3965a2-75be-4534-a815-b4c69496b368
	measure 'Total Estimated Revenue' = SUMX(fact_product_snapshot, fact_product_snapshot[price] * fact_product_snapshot[quantity_sold])
		formatString: #,##0₫
		lineageTag: 71a8fb12-32a1-4354-a951-8743c4a20001

	measure 'Total Volume Sold' = SUM(fact_product_snapshot[quantity_sold])
		formatString: #,##0
		lineageTag: 71a8fb12-32a1-4354-a951-8743c4a20002

	measure 'Average Rating' = AVERAGE(fact_product_snapshot[rating_average])
		formatString: 0.00
		lineageTag: 71a8fb12-32a1-4354-a951-8743c4a20003

	measure 'Total Active SKUs' = DISTINCTCOUNT(fact_product_snapshot[product_id])
		formatString: #,##0
		lineageTag: 71a8fb12-32a1-4354-a951-8743c4a20004

	measure 'Average Discount Rate %' = DIVIDE(AVERAGE(fact_product_snapshot[discount_rate_calc]), 100, 0)
		formatString: 0.0%
		lineageTag: 71a8fb12-32a1-4354-a951-8743c4a20005

	measure 'CR5 Index %' = ```
			VAR Top5Revenue = 
			    CALCULATE(
			        [Total Estimated Revenue],
			        TOPN(5, ALL(dim_brand[brand_name]), [Total Estimated Revenue], DESC)
			    )
			VAR TotalRevenueAll = 
			    CALCULATE([Total Estimated Revenue], ALL(dim_brand))
			RETURN
			    DIVIDE(Top5Revenue, TotalRevenueAll, 0)
			```
		formatString: 0.0%
		lineageTag: 71a8fb12-32a1-4354-a951-8743c4a20006

	measure 'Average Review Count' = AVERAGE(fact_product_snapshot[review_count])
		formatString: #,##0
		lineageTag: 71a8fb12-32a1-4354-a951-8743c4a20007

