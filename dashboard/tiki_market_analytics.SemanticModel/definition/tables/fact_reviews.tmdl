table fact_reviews
	lineageTag: d7cc88e5-2901-4ea3-ad9f-dae2e7d8df3f

	measure 'Total Reviews' = COUNTROWS(fact_reviews)
		formatString: #,##0
		lineageTag: 82b9fc23-43b2-4896-b062-9854d5b30001

	measure 'Positive Review Ratio %' = ```
			VAR PositiveCount = 
			    CALCULATE(COUNTROWS(fact_reviews), fact_reviews[sentiment_label] = "positive")
			VAR TotalReviews = 
			    COUNTROWS(fact_reviews)
			RETURN
			    DIVIDE(PositiveCount, TotalReviews, 0)
			```
		formatString: 0.0%
		lineageTag: 82b9fc23-43b2-4896-b062-9854d5b30002

	measure 'Negative Review Ratio %' = ```
			VAR NegCount = 
			    CALCULATE(COUNTROWS(fact_reviews), fact_reviews[sentiment_label] = "negative")
			VAR TotalReviews = 
			    COUNTROWS(fact_reviews)
			RETURN
			    DIVIDE(NegCount, TotalReviews, 0)
			```
		formatString: 0.0%
		lineageTag: 82b9fc23-43b2-4896-b062-9854d5b30003

	measure 'AfterSales Complaint %' = ```
			VAR AfterSalesCount = 
			    CALCULATE(
			        COUNTROWS(fact_reviews),
			        fact_reviews[is_after_sales_complaint] = TRUE(),
			        fact_reviews[sentiment_label] = "negative"
			    )
			VAR TotalNegative = 
			    CALCULATE(COUNTROWS(fact_reviews), fact_reviews[sentiment_label] = "negative")
			RETURN
			    DIVIDE(AfterSalesCount, TotalNegative, 0)
			```
		formatString: 0.0%
		lineageTag: 82b9fc23-43b2-4896-b062-9854d5b30004

	measure 'Hardware Defect %' = ```
			VAR DefectCount = 
			    CALCULATE(
			        COUNTROWS(fact_reviews),
			        fact_reviews[is_defect_complaint] = TRUE(),
			        fact_reviews[sentiment_label] = "negative"
			    )
			VAR TotalNegative = 
			    CALCULATE(COUNTROWS(fact_reviews), fact_reviews[sentiment_label] = "negative")
			RETURN
			    DIVIDE(DefectCount, TotalNegative, 0)
			```
		formatString: 0.0%
		lineageTag: 82b9fc23-43b2-4896-b062-9854d5b30005

	measure 'Reviews By Seller' = ```
			CALCULATE(
			    COUNTROWS(fact_reviews),
			    TREATAS(
			        VALUES(fact_product_snapshot[product_sk]),
			        fact_reviews[product_sk]
			    )
			)
			```
		formatString: #,##0
		lineageTag: 82b9fc23-43b2-4896-b062-9854d5b30006


