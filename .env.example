# ==========================================
# Tiki API Configuration
# ==========================================
TIKI_API_BASE_URL=https://tiki.vn/api/v2
TIKI_CATEGORY_ID=1882
TIKI_REQUEST_DELAY=0.5
TIKI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ==========================================
# Kafka Configuration
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PRODUCTS=raw-products
KAFKA_TOPIC_PRICE_EVENTS=raw-price-events
KAFKA_TOPIC_REVIEWS=raw-reviews

# ==========================================
# MinIO / S3 Configuration
# ==========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin12345
MINIO_BUCKET=lakehouse

# ==========================================
# PostgreSQL DWH Configuration
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tiki_dwh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==========================================
# Telegram Alert Bot (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
